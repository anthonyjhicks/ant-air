# Ant Air configuration. Copy this file to .env and fill in the values.
# The app loads this file itself (python-dotenv), so the Flask CLI, Gunicorn,
# the MCP server and the scripts in scripts/ all see the same settings.
# Variables already set in the environment take precedence. Quote values
# that contain spaces, e.g. HOME_COUNTRY="United Kingdom".

# ── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. "postgresql://" is rewritten to
# "postgresql+psycopg://" automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ant_air
SECRET_KEY=change-me-to-a-long-random-string

# ── Personalisation (all optional) ────────────────────────────────────────
# Shown in the navbar, page titles and the MCP server description.
APP_NAME=Ant Air
# Traveller name used when an import or webhook does not supply one.
DEFAULT_TRAVELLER=
# Your home base. Used to spot missing return legs, to exclude "home" from
# top-destination cards, and as the default city on the route audit.
HOME_CITY=
HOME_COUNTRY=
# Comma-separated IATA codes that count as home airports (e.g. LHR,LGW,LCY).
HOME_AIRPORTS=

# ── Integrations (optional) ───────────────────────────────────────────────
# FlightAware AeroAPI: flight history and aircraft registration lookups.
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_API_BASE_URL=https://aeroapi.flightaware.com/aeroapi
FLIGHT_DATA_PROVIDER=flightaware
# Google Gemini: AI insights, codeshare detection, registration/boarding-pass OCR.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=
# Bearer token the /webhooks/n8n endpoint expects.
N8N_WEBHOOK_TOKEN=
# Geocode airports/cities with Nominatim during imports.
GEOCODE_ON_IMPORT=false
MISSING_LEG_WINDOW_DAYS=30

# ── API / iOS app auth ────────────────────────────────────────────────────
# Defaults to SECRET_KEY when unset.
JWT_SECRET_KEY=

# ── MCP server (python -m app.mcp_server) ─────────────────────────────────
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
MCP_AUTH_TOKEN=
